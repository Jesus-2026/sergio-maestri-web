# ── Dependencias ─────────────────────────────────────────────
node_modules/

# ── Salida y caché del build ─────────────────────────────────
dist/
.astro/

# ── Netlify ──────────────────────────────────────────────────
# La CLI de Netlify crea esta carpeta con el identificador del
# sitio y estado local. No va al repositorio.
.netlify/

# ── Variables de entorno ─────────────────────────────────────
# Cubre .env, .env.local, .env.production y cualquier variante.
.env
.env.*
!.env.example

# Convención de Astro y Vite para archivos locales
*.local

# ── Informes de auditoría ────────────────────────────────────
lh*.json

# ── Editores ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Sistema operativo ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Registros ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
