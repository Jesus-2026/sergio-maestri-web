---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
}

const {
  titulo,
  descripcion,
  /* TODO Fase 4 — reemplazar por el recorte 1200×630 (<300 KB) que se
     genera desde hero2.png. Hoy apunta al PNG de 2 MB, que es la razón
     por la que WhatsApp no muestra previsualización. */
  imagen = '/img/hero2.png',
} = Astro.props;

/* Todas las URLs se derivan de `site` en astro.config.mjs.
   Cambiar el dominio = editar una sola línea de ese archivo. */
const canonical  = new URL(Astro.url.pathname, Astro.site).href;
const imagenAbs  = new URL(imagen, Astro.site).href;
---
<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <meta name="author" content="Sergio Maestri" />
  <link rel="canonical" href={canonical} />

  <!-- Identidad visual -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#f6f1e7" />

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Sergio Maestri - Escritor" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:image" content={imagenAbs} />
  <meta property="og:image:alt" content="Sergio Maestri, escritor argentino" />
  <meta property="og:locale" content="es_AR" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content={imagenAbs} />

  <!-- Tipografías -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet"
  />

  <slot name="head" />
</head>

<body>
  {/* Salto de navegación: invisible hasta enfocarlo con Tab */}
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <Nav />

  {/* Landmark <main>, ausente en el sitio original */}
  <main id="contenido">
    <slot />
  </main>

  <Footer />

  {/* Overlays fuera de main: visor de imágenes */}
  <slot name="after" />
</body>
</html>
