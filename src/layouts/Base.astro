---
import { getImage, Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DatosEstructurados from '../components/DatosEstructurados.astro';
import heroImg from '../assets/img/hero2.png';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;

const a = (await getEntry('ajustes', 'sitio'))!.data;

/* ── Imágenes sociales ────────────────────────────────────────────────
   Antes og:image apuntaba al PNG de 1.998 KB. WhatsApp descarta las
   previsualizaciones por encima de ~300 KB, y por eso al compartir el
   sitio no aparecía imagen. Se recorta desde el hero, que es donde
   está el retrato real del autor.

   (autor.jpg NO sirve para esto: es una fotografía de una biblioteca,
   no del autor. Se usa solo como banner decorativo en Presentación.) */
const og = await getImage({
  src: heroImg, width: 1200, height: 630, format: 'jpeg', quality: 82,
});

/* Retrato cuadrado para Person.image de Schema.org. La cara está en el
   tercio izquierdo del encuadre, de ahí el position. */
const retrato = await getImage({
  src: heroImg, width: 800, height: 800, format: 'jpeg', quality: 82, position: 'left',
});

/* Todas las URLs derivan de `site` en astro.config.mjs */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogAbs = new URL(og.src, Astro.site).href;
---
<!DOCTYPE html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <meta name="author" content={a.nombreCompleto} />
  <link rel="canonical" href={canonical} />

  <!-- Identidad visual -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#f6f1e7" />

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={a.nombreSitio} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:image" content={ogAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={a.ogImagenAlt} />
  <meta property="og:locale" content="es_AR" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content={ogAbs} />

  <!-- Tipografías autoalojadas: sin peticiones a terceros ni bloqueo de render -->
  <Font cssVariable="--fuente-titulos" preload />
  <Font cssVariable="--fuente-texto" />

  <!-- Datos estructurados / Schema.org -->
  <DatosEstructurados retrato={retrato.src} />

  <slot name="head" />
</head>

<body>
  {/* Salto de navegación: invisible hasta enfocarlo con Tab */}
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <Nav />

  {/* Landmark <main>, ausente en el sitio original */}
  <main id="contenido">
    <slot />
  </main>

  <Footer />

  {/* Overlays fuera de main: visor de imágenes */}
  <slot name="after" />
</body>
</html>
