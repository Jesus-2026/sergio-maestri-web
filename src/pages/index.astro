---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Presentacion from '../components/Presentacion.astro';
import Biografia from '../components/Biografia.astro';
import Premios from '../components/Premios.astro';
import Obras from '../components/Obras.astro';
import Prensa from '../components/Prensa.astro';
import Blog from '../components/Blog.astro';
import Contacto from '../components/Contacto.astro';
import Lightbox from '../components/Lightbox.astro';

const a = (await getEntry('ajustes', 'sitio'))!.data;

/* El titulo y la descripcion son los dos textos de mayor peso para
   Google. Viven en Ajustes del sitio para que sean editables. */
const titulo      = a.tituloSeo;
const descripcion = a.descripcionSeo;
---

<Base titulo={titulo} descripcion={descripcion}>

  {/* One-page (Opción A): las 7 anclas del menú apuntan a estas
      secciones. El clic hace scroll suave, no navega a otra URL. */}

  <Hero
    tagline={a.heroTagline}
    titulo={a.heroTitulo}
    frase={a.heroFrase}
    cta={a.heroCta}
    ctaDestino={a.heroCtaDestino}
    alt={a.heroAlt}
  />

  <Presentacion />
  <Biografia />
  <Premios />
  <Obras />
  <Prensa />
  <Blog />
  <Contacto />

  <Lightbox slot="after" />

</Base>
