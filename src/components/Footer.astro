---
// El año se calcula en el BUILD, no en el navegador.
// Antes era JavaScript en cliente (index.html:516).
import { getEntry } from 'astro:content';

const a = (await getEntry('ajustes', 'sitio'))!.data;
const anio = new Date().getFullYear();
---

<footer>
  <div class="brand-f">{a.marcaNombre}</div>
  <p class="linea">{a.pieLinea}</p>
  <p>© {anio} {a.marcaNombre}. Todos los derechos reservados.</p>
</footer>

<style>
  /* Valores extraídos textualmente del CSS original */
  footer {
    background: var(--tinta);
    color: #cabfa9;
    text-align: center;
    padding: 2.5rem 1.5rem;
    font-size: .85rem;
  }

  .brand-f {
    font-family: var(--fuente-titulos);
    font-size: 1.4rem;
    color: #f6f1e7;
    letter-spacing: .06em;
  }

  .linea { margin: .6rem 0; }

  footer :global(a) { color: var(--dorado-claro); }
</style>
