---
import { inline } from '../lib/markdown';
interface Props { titulo: string; items: string[]; }
const { titulo, items } = Astro.props;
---
<div class="prensa-block">
  <h3>{titulo}</h3>
  <ul>
    {items.map((t) => <li set:html={inline(t)} />)}
  </ul>
</div>

<style>
  .prensa-block { margin-bottom: 2.6rem; }
  .prensa-block h3 {
    font-size: 1.6rem;
    color: var(--marron);
    margin-bottom: 1rem;
    padding-bottom: .4rem;
    border-bottom: 2px solid var(--linea);
  }
  .prensa-block ul { list-style: none; }
  .prensa-block li { padding: .5rem 0; padding-left: 1.4rem; position: relative; }
  /* Los enlaces se distinguían solo por color, con 1.98:1 respecto del
     texto que los rodea. Quien no diferencia bien los colores no veía
     que fueran enlaces. */
  /* :global(a) es imprescindible: estos enlaces se generan desde
     markdown con set:html, así que no reciben el atributo de scope
     que Astro agrega a los elementos de la plantilla. Sin :global,
     el selector nunca coincide. */
  .prensa-block li :global(a) {
    text-decoration: underline;
    text-underline-offset: .18em;
    text-decoration-thickness: 1px;
  }

  .prensa-block li::before { content: "\276E"; position: absolute; left: 0; color: var(--dorado); }
</style>
