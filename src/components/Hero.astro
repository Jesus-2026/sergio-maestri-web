---
import { Picture } from 'astro:assets';
import heroImg from '../assets/img/hero2.png';

interface Props {
  tagline: string; titulo: string; frase: string;
  cta: string; ctaDestino: string;
}
const { tagline, titulo, frase, cta, ctaDestino } = Astro.props;

/* FASE 4 — El hero pasó de background-image en CSS a <img> real.
   Motivo: como fondo CSS no admite srcset ni precarga, y el navegador
   ni siquiera lo descubre hasta parsear el CSS. Era el elemento LCP y
   pesaba 1.998 KB en PNG, servido igual a un celular de 390px.

   El resultado visual es idéntico:
     background-size: cover        →  object-fit: cover
     background-position: center 30% →  object-position: center 30%
     el degradado                  →  pseudo-elemento ::after
*/
---
<section class="hero" id="inicio">
  <Picture
    src={heroImg}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    widths={[640, 960, 1280, 1672]}
    sizes="100vw"
    alt="Sergio Maestri, escritor argentino, en su biblioteca"
    class="hero-img"
    pictureAttributes={{ class: 'hero-pic' }}
    loading="eager"
    fetchpriority="high"
  />

  <div class="hero-inner">
    <small>{tagline}</small>
    <h1>{titulo}</h1>
    <p>{frase}</p>
    <a class="cta" href={ctaDestino}>{cta}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    text-align: left;
    padding: 5rem clamp(1.5rem, 6vw, 5rem);
    color: #f6f1e7;
    overflow: hidden;
    /* Primer elemento del documento: ver nota del commit 672d8de */
    scroll-margin-top: 8rem;
  }

  /* La imagen ocupa toda la sección, igual que hacía como fondo */
  .hero :global(.hero-pic) { display: contents; }
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* El degradado que antes era la primera capa de background-image */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(31, 27, 22, .18),
      rgba(31, 27, 22, .30) 45%,
      rgba(31, 27, 22, .78) 100%
    );
  }

  .hero-inner { position: relative; z-index: 2; max-width: 600px; }

  .hero small {
    display: block;
    letter-spacing: .4em;
    text-transform: uppercase;
    font-size: .8rem;
    color: var(--dorado-claro);
    margin-bottom: 1.2rem;
  }

  .hero h1 { font-size: clamp(2.8rem, 7vw, 5rem); color: #fff; font-weight: 600; }

  .hero p {
    font-size: 1.25rem;
    font-style: italic;
    margin-top: 1.2rem;
    color: #f0e9da;
  }

  .hero .cta {
    display: inline-block;
    margin-top: 2rem;
    padding: .7rem 1.8rem;
    border: 1px solid var(--dorado-claro);
    color: #f6f1e7;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-size: .8rem;
    border-radius: 2px;
  }

  .hero .cta:hover { background: var(--dorado-claro); color: var(--tinta); }

  @media (max-width: 760px) {
    .hero {
      justify-content: center;
      text-align: center;
      padding: 5rem 1.5rem;
    }
    .hero :global(.hero-img) { object-position: 32% 30%; }
    .hero::after {
      background: linear-gradient(rgba(31, 27, 22, .5), rgba(31, 27, 22, .62));
    }
  }
</style>
