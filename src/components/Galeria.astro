---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  imagenes: { imagen: ImageMetadata; alt: string }[];
  nota?: string;
  clase?: 'gallery' | 'mag-grid';
}
const { imagenes, nota = '', clase = 'gallery' } = Astro.props;

/* Variante grande en WebP para el visor. Antes abría el archivo
   original crudo (hasta 167 KB en JPG); ahora pesa la mitad. */
const items = await Promise.all(
  imagenes.map(async ({ imagen, alt }) => ({
    imagen,
    alt,
    full: (await getImage({
      src: imagen,
      width: Math.min(imagen.width, 1600),
      format: 'webp',
      quality: 82,
    })).src,
  }))
);
---
{/* Reemplaza fill(id, dir, prefijo, N, ext) del sitio anterior.
    La cantidad sale de la lista: ya no hay contadores fijos que
    queden desactualizados al subir una imagen desde el panel. */}
<div class={clase} data-galeria>
  {items.map(({ imagen, alt, full }) => (
    <Image src={imagen} alt={alt} data-full={full} widths={[300, 600]} sizes="(max-width:760px) 45vw, 200px" loading="lazy" />
  ))}
</div>
{nota && <p class="gallery-note">{nota}</p>}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: .9rem;
    margin-top: 1.5rem;
  }
  .gallery :global(img) {
    width: 100%;
    /* Astro agrega width/height al <img> para evitar el salto de layout.
       Ese height entra como sugerencia de presentación y le gana a
       aspect-ratio, que es lo que deformaba la cuadrícula. height:auto
       lo neutraliza y deja que la proporción mande. */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 3px;
    box-shadow: 0 2px 8px var(--sombra);
    cursor: pointer;
    transition: transform .2s;
  }
  .gallery :global(img:hover) { transform: scale(1.03); }

  .mag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 1rem;
    max-width: 820px;
    margin: 0 auto;
  }
  .mag-grid :global(img) {
    border-radius: 3px;
    box-shadow: 0 2px 8px var(--sombra);
    cursor: pointer;
    transition: transform .2s;
    width: 100%;
    height: auto;
  }
  .mag-grid :global(img:hover) { transform: translateY(-3px); }

  .gallery-note {
    text-align: center;
    font-style: italic;
    color: var(--tinta-suave);
    font-size: .92rem;
    margin-top: .8rem;
  }
</style>
